# Copie para deploy/.env (fica fora do controle de versão).
# E-mail do admin master (único, inalterável pela interface).
FLOWS_MASTER_EMAIL=contato@gplansis.com
# Nome exibido do admin master (opcional).
# FLOWS_MASTER_NAME=Administrador
# Senha provisória do master: usada só na primeira subida (banco vazio). Troca obrigatória no 1º acesso.
FLOWS_MASTER_PASSWORD=
# IA (Claude): deixe vazio para desligar. Modelo padrão: claude-opus-5-5.
ANTHROPIC_API_KEY=
# FLOWS_AI_MODEL=claude-opus-5-5
